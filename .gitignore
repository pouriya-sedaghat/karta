/data/local/
# Default local publication inbox (KARTA_INBOX_HOST_DIR)
/data/inbox/
*.osm.pbf
# Committed, deterministic test snapshots (go run ./cmd/karta-fixture)
!/testdata/fixture/snapshots/*.osm.pbf
*.osm.pbf.provenance.json
__pycache__/
# Generated database passwords (scripts/gen-secrets.sh)
/secrets/
# Demo build output and npm install tree
/web/node_modules/
/web/dist/
# Test artefacts (screenshots, reports)
/artifacts/
# Backups and restore reports (scripts/backup.sh, scripts/restore.sh): data and
# role password verifiers; never commit them
/backups/
# The co-located bridge's generated CA certificate (scripts/gen-bridge-tls.sh)
/config/sources/bridge-ca.pem
