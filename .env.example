# Karta configuration example. Copy to .env to override Compose defaults.
# Secrets are never set here: they are files in ./secrets/ (created by
# `make secrets`) mounted as Docker secrets:
#   secrets/db_superuser_password   PostgreSQL superuser (initialisation and maintenance only)
#   secrets/db_importer_password    role karta_importer (publisher and importer: creates release databases)
#   secrets/db_api_password         role karta_api (read-only serving)
#   secrets/operator_token          operator API token, all scopes (operator-cli / curl only)
#   secrets/operator_monitor_token  operator API token, status scope (monitoring)
#   secrets/operator_tokens         NAME SCOPES SHA256(token) per line: what the publisher reads
#   secrets/metrics_tokens          the monitoring credential's hash: what the API's metrics listener reads
#   secrets/db_monitor_password     role karta_monitor (the PostgreSQL exporter; make up-monitoring)
#   secrets/operator_tokens.extra   narrow extra credentials (scripts/operator-credential.sh)
#   secrets/intake_watch_token      the intake watcher's credential (scope intake_watch; make up-intake)
#   secrets/NAME.token              a person's intake command credential (scope intake_submit)
#   secrets/bridge/                 the bridge's signing key (its custodian's) and TLS files (make bridge-tls)
# For a production host see docs/operations.md, "Production secret distribution".

# --- HTTP (compose) ---------------------------------------------------------
# Absolute URL clients use to reach the API. Style, tile and glyph URLs are
# built from it (never from the Host header); the demo page must be opened here.
KARTA_PUBLIC_BASE_URL=http://localhost:8080
# Host interface and port the API is published on. Keep 127.0.0.1 unless a
# reverse proxy on another host needs to reach it.
KARTA_HTTP_BIND=127.0.0.1
KARTA_HTTP_PORT=8080
# Comma-separated origins allowed to call the API from browsers, or *.
# Empty: no cross-origin access (the bundled demo is same-origin).
KARTA_CORS_ALLOWED_ORIGINS=
KARTA_LOG_LEVEL=info
# Host interface and port of the API's metrics listener (monitoring credential
# only; never the public listener). Also the bind of the monitoring profile.
KARTA_METRICS_BIND=127.0.0.1
KARTA_API_METRICS_PORT=9464

# --- API process (karta serve) --------------------------------------------------
# KARTA_LISTEN_ADDR=:8080
# KARTA_DB_HOST=db
# KARTA_DB_PORT=5432
# KARTA_DB_USER=karta_api
# KARTA_DB_PASSWORD_FILE=/run/secrets/db_api_password
# KARTA_DB_SSLMODE=disable            # internal Docker network; use verify-full across hosts
# KARTA_REGISTRY_DB=karta_registry
# KARTA_DB_STATEMENT_TIMEOUT=3s       # per SQL statement; must be below the request timeout
# KARTA_DB_MAX_CONNS=8                # per release database pool
# KARTA_REQUEST_TIMEOUT=10s
KARTA_RELEASE_POLL_INTERVAL=5s
# KARTA_WEB_DIR=/opt/karta/web        # demo assets; empty disables /demo/
# KARTA_METRICS_LISTEN_ADDR=:9464     # empty (outside Compose): no metrics listener; must differ from KARTA_LISTEN_ADDR
# KARTA_METRICS_TOKENS_FILE=/run/secrets/metrics_tokens   # re-read when it changes

# --- API: pinned releases -------------------------------------------------------------
# A release that stops being served keeps its database pool for
# KARTA_REQUEST_TIMEOUT + 5 s, so requests in progress finish on it.

# --- publisher (karta publisher) and operator API ----------------------------------------
# Region this deployment publishes (config/regions/<name>.json).
KARTA_PUBLISH_REGION=tehran-chitgar
# Host directory mounted read-only as the inbox.
# KARTA_INBOX_HOST_DIR=./data/inbox
# Operator API port, published on this host interface only.
KARTA_OPERATOR_BIND=127.0.0.1
KARTA_OPERATOR_PORT=8081
# Activate validated inbox submissions automatically (false: they stay ready
# for `make op CMD='activate ...'`).
KARTA_PUBLISH_AUTO_ACTIVATE=true
# KARTA_INBOX_POLL_INTERVAL=10s       # rescan period (also after restarts)
# KARTA_INBOX_SETTLE=5s               # files must be unchanged this long after the ready marker
# KARTA_INBOX_MAX_ENTRIES=1000
# How long a replaced release stays servable to clients that pinned it.
KARTA_RELEASE_PIN_GRACE=24h
# Validated non-active releases kept for rollback (plus any still pinned).
KARTA_RETAIN_RELEASES=2
# KARTA_CLEANUP_MARGIN=5m             # added to the pin grace before removal; > API drain
# KARTA_CLEANUP_INTERVAL=15m
# KARTA_PUBLISH_MAX_ATTEMPTS=3        # retries of an interrupted submission
# Deadline of a whole publication (staging through validation; inbox, online
# and karta import). PROVISIONAL default: set it from the publication time
# measured on the target host plus a margin (docs/operations.md). A timed-out
# publication fails with publication_timeout and is not retried automatically.
# KARTA_PUBLISH_TIMEOUT=6h
# KARTA_POINTER_LOCK_TIMEOUT=5s       # wait for the active-pointer lock (then 409 busy)
# KARTA_MAX_FUTURE_SKEW=10m           # data timestamps later than now + this are refused
# KARTA_OPERATOR_REQUEST_TIMEOUT=60s
# Storage checks before each build (see docs/runbook.md, "Storage").
KARTA_RELEASE_STORAGE_BUDGET_MB=10240
KARTA_MIN_FREE_MB=512
KARTA_STAGING_RESERVE_MB=64
# KARTA_CANDIDATE_SIZE_FACTOR=40
# KARTA_DB_VOLUME_PATH=               # database volume mounted in the publisher, for a free-space check
# KARTA_RELEASE_TABLESPACE=           # PostgreSQL tablespace for new release databases
# KARTA_STAGING_DIR=/var/lib/karta/staging
# KARTA_REGION_FILE, KARTA_INBOX_DIR, KARTA_OPERATOR_TOKENS_FILE are set in compose.yaml.
# Data age after which the active release is reported stale (status, metrics,
# manifest freshness.stale). Empty: no threshold. Owner decision (permitted lag).
# KARTA_DATA_STALE_AFTER=48h

# --- online updates (Stage 3, opt-in; docs/runbook.md "Online updates") ------------
# Empty (the default) keeps online updates off. Set it to a reviewed source file
# in config/sources/ (provider URL, pinned signing keys, limits) and start with
# `make up-online`. No production source is configured.
# KARTA_ONLINE_SOURCE_FILE=/config/sources/NAME.json
# KARTA_ONLINE_RESERVE_MB=64          # free space the fetcher keeps on its outbox volume
# KARTA_FETCHER_MEM_LIMIT=256m
# KARTA_FETCHER_CPUS=0.5
# Operator client (karta operator): KARTA_OPERATOR_URL, KARTA_OPERATOR_TOKEN_FILE.

# --- local intake (Stage 5, opt-in; docs/runbook.md "Local intake") ----------------
# Empty (the default) keeps the local intake off: the publisher accepts no
# intake authorization. /data/intake (the `intake` volume) enables it for the
# authenticated command (make intake-submit) and the watcher (make up-intake).
# KARTA_INTAKE_DIR=/data/intake
# KARTA_INTAKE_MAX_OPEN=2             # open intake authorizations per credential
# Cap on an intake authorization's lifetime. Empty: derived,
# (1 + MAX_OPEN x KARTA_PUBLISH_MAX_ATTEMPTS) x KARTA_PUBLISH_TIMEOUT + 1h (43h).
# KARTA_INTAKE_AUTHORIZATION_MAX_AGE=
# KARTA_INTAKE_AUTHORIZATION_TTL=     # what the intake requests (empty: the cap)
# The watcher only: the protected landing area (a host directory on a local
# POSIX filesystem, owned by the landing account, writable by nobody else;
# check it with make intake-check), its owner's numeric UID, and optionally
# the one group allowed to write it.
# KARTA_INTAKE_LANDING_HOST_DIR=/srv/karta/landing
# KARTA_INTAKE_LANDING_UID=1001
# KARTA_INTAKE_WRITER_GID=
# KARTA_INTAKE_SETTLE=10s             # unchanged this long after the completion marker
# KARTA_INTAKE_POLL_INTERVAL=10s
# KARTA_INTAKE_RESERVE_MB=64          # free space kept on the handoff volume
# KARTA_INTAKE_MEM_LIMIT=256m
# KARTA_INTAKE_CPUS=0.5

# --- controlled source bridge (Stage 5, opt-in; compose.bridge.yaml) ------------------
# Empty keeps the bridge off. A reviewed source file in config/bridge/ (see
# config/bridge/README.md; starting it downloads the full snapshot it names)
# and the fetcher's source file for the bridge (config/sources/README.md).
# KARTA_BRIDGE_SOURCE_FILE=/config/bridge/geofabrik-iran.json
# KARTA_BRIDGE_SIGNER_FILE=/config/bridge/signer.json
# KARTA_BRIDGE_SIGNING_KEY_FILE=./secrets/bridge/signing-key.pem   # provided by its custodian
# KARTA_BRIDGE_TLS_CERT_FILE=./secrets/bridge/tls.pem              # make bridge-tls
# KARTA_BRIDGE_TLS_KEY_FILE=./secrets/bridge/tls-key.pem
# KARTA_BRIDGE_BIND=127.0.0.1         # bridge-serve's published HTTPS port (a separate bridge host: its interface)
# KARTA_BRIDGE_PORT=8443
# KARTA_BRIDGE_SUBNET=10.233.0.0/24   # the `bridge` network; the fetcher's allowed_networks
# KARTA_BRIDGE_METRICS_LISTEN_ADDR=:9465   # bridge-serve's metrics (monitoring credential); empty: off
# KARTA_BRIDGE_METRICS_PORT=9465
# KARTA_BRIDGE_RESERVE_MB=64
# KARTA_BRIDGE_ACQUIRE_MEM_LIMIT=256m
# KARTA_BRIDGE_SIGN_MEM_LIMIT=512m
# KARTA_BRIDGE_SERVE_MEM_LIMIT=128m

# --- monitoring (opt-in: make up-monitoring; docs/operations.md "Monitoring") ---------------
# KARTA_DB_METRICS_PORT=9187          # PostgreSQL exporter, on KARTA_METRICS_BIND
# KARTA_PROMETHEUS_PORT=9090          # Prometheus UI and API (no authentication: keep it on loopback)
# KARTA_PROMETHEUS_RETENTION=15d
# KARTA_PROMETHEUS_MEM_LIMIT=512m

# --- importer (karta import) and builds (also the publisher) ------------------------------
# KARTA_DB_USER=karta_importer
# KARTA_DB_PASSWORD_FILE=/run/secrets/db_importer_password
# KARTA_TEMPLATE_DB=karta_template
# KARTA_MAX_INPUT_MB=4096             # snapshots above this size are refused
# KARTA_OSM2PGSQL=osm2pgsql
KARTA_OSM2PGSQL_CACHE_MB=800
KARTA_OSM2PGSQL_PROCESSES=2
# KARTA_OSM2PGSQL_SLIM=false          # true for large regions (disk-backed middle, dropped after import)
# KARTA_IMPORT_LOCK_TIMEOUT=30s

# --- resource limits (compose) --------------------------------------------------------
KARTA_DB_MEM_LIMIT=2g
KARTA_DB_CPUS=2
KARTA_DB_SHARED_BUFFERS=256MB
KARTA_API_MEM_LIMIT=512m
KARTA_API_CPUS=1
KARTA_IMPORTER_MEM_LIMIT=4g
KARTA_PUBLISHER_MEM_LIMIT=4g
KARTA_PUBLISHER_CPUS=2

# --- build ---------------------------------------------------------------------------
# Optional PEM bundle for TLS-intercepting build networks (Makefile passes it
# as the `build_ca` build secret).
# KARTA_BUILD_CA_FILE=/path/to/ca.pem
